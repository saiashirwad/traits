{
  "name": "root",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "tasks": "node tasks/main.ts",
    "changeset": "changeset",
    "format": "vp fmt .",
    "prepare": "effect-tsgo patch --oxlint",
    "build": "tsc -b tsconfig.json",
    "test": "vp check && pnpm build && pnpm test:oxlints && pnpm test:traits",
    "test:oxlints": "vp test run --project oxlints",
    "test:traits": "vp test run --project traits --passWithNoTests",
    "test:traits:integration": "vp test run --config traits.integration.config.ts"
  },
  "dependencies": {
    "alchemy": "catalog:",
    "effect": "catalog:",
    "traits": "workspace:*"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/ai-openai-compat": "catalog:",
    "@effect/ai-typesafe": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "pkg-pr-new": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.8.1"
}
